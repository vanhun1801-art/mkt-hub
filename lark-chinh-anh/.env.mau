# Mau file .env cho app Chinh anh & Edit video.
# COPY thanh .env (khong co duoi .mau) roi dien. .env da bi .gitignore chan.
#
# ====== App Lark dung ten gui tin vao nhom SUA ANH ======
# Anh Hung chon app "Marketing Hub" (KHONG phai "Tracking" - do la app khac).
# Lay ca hai gia tri o Developer Console:
#   https://open.larksuite.com/app/  ->  Custom Apps  ->  Marketing Hub
#   -> Credentials & Basic Info  ->  App ID va App Secret
#
# PHAI dien CA HAI. Dien secret ma de sai App ID thi Lark tra loi token,
# nhin vao khong hieu vi sao - nen app khong cam san App ID nao.
ANH_TIN_APP_ID=
ANH_TIN_APP_SECRET=

# Chi de HIEN THI cho khop ten trong Console (de tim dung bot luc moi vao nhom).
# ANH_TIN_APP_TEN=Marketing Hub
